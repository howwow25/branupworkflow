# 파이썬 캐시 (pytest 를 들이면서 생긴다)
__pycache__/
*.py[cod]
.pytest_cache/

# 운영 데이터. 저장소에 들어가면 서버의 업무를 덮어쓴다.
data/
db/
files/

# 구워 낸 화면. **추적하면 배포가 실패할 때 6월로 되돌아간다.**
#
# 이 파일이 곧 웹 서버가 내주는 페이지다(`dashboard_html.py` 가 여기에 쓴다).
# 한때 매시 cron 이 이것을 커밋했고(2026-06-22 19:51 에 멈췄다), 그 뒤로
# git 안의 사본은 6월에 얼어 있었다. `update.ps1` 은 `reset --hard` 로
# 그 6월 파일을 되살린 **뒤에** 다시 굽는데, 그 사이에서 멈추면
# (pytest 가 하나라도 실패하면 `throw` 한다) **서비스되는 화면이 다섯 달
# 전으로 돌아간 채 남는다.** 배포 실패가 '아무 일 없음' 이 아니라
# '되돌림' 이 되는 자리였다.
index.html

# 도구가 만드는 폴더
.claude/
.gstack/
